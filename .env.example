# ─────────────────────────────────────────────────────────────────
# PartyPilot — Local Terraform Deployment Environment
# ─────────────────────────────────────────────────────────────────
#
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in your secrets
# 3. Run:  ./terraform/deploy-local.sh
#
# .env is gitignored — never commit real secrets.
# For CI/CD, these are set as GitHub secrets instead.
# ─────────────────────────────────────────────────────────────────

# ── Scaleway (provider + S3 backend) ─────────────────────────────
# Console → IAM → API Keys
SCW_ACCESS_KEY=SCW0GJADDFXCGHV8HJG7
SCW_SECRET_KEY=63f3467f-0a91-443c-b930-78f119aa2a71
SCW_DEFAULT_PROJECT_ID=de51c9c0-71ad-4f53-b784-10bbface89aa

# ── AWS S3 backend workaround ────────────────────────────────────
# Scaleway Object Storage is S3-compatible. We point AWS env vars
# at Scaleway creds and disable local AWS config files.
AWS_SHARED_CREDENTIALS_FILE=/dev/null
AWS_CONFIG_FILE=/dev/null
AWS_ACCESS_KEY_ID=SCW0GJADDFXCGHV8HJG7
AWS_SECRET_ACCESS_KEY=63f3467f-0a91-443c-b930-78f119aa2a71

# ── Cloudflare (DNS + CDN) ───────────────────────────────────────
# Dashboard → My Profile → API Tokens → Create Token
# Zone ID: Dashboard → your domain → Overview (right sidebar)
TF_VAR_cloudflare_api_token=
TF_VAR_cloudflare_zone_id=

# ── Scaleway TEM (Transactional Email) ───────────────────────────
# Console → Transactional Email → SMTP credentials
TF_VAR_smtp_username=
TF_VAR_smtp_password=

# ── Mistral AI (chatbot) ─────────────────────────────────────────
# https://console.mistral.ai/api-keys
TF_VAR_mistral_api_key=

# ── Terraform variables (non-secret, already have defaults) ──────
# These are here for reference — uncomment to override.
# TF_VAR_domain_name=partypilot.pl
# TF_VAR_allowed_origins=https://partypilot.pl,https://www.partypilot.pl
