locals {
  # Constructed database URL using the DB instance outputs
  database_url = "postgresql://${scaleway_rdb_instance.db.user_name}:${urlencode(random_password.db_password.result)}@${scaleway_rdb_instance.db.endpoint_ip}:${scaleway_rdb_instance.db.endpoint_port}/${scaleway_rdb_database.db.name}"

  # Function endpoint (auto-generated by Scaleway)
  function_endpoint = scaleway_function.api.domain_name

  # Convert tags object to list of "key=value" strings (Scaleway format)
  common_tags_list = [
    for k, v in var.common_tags : "${k}=${v}"
  ]

  # Tags as map of string (for scaleway_object_bucket which requires map)
  common_tags_map = var.common_tags
}
